{
  "name": "word-frequency-counter-javascript",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "audit": "bun audit --audit-level=low",
    "format:check": "prettier . --check",
    "format:fix": "prettier . --write --cache --list-different",
    "lint:check": "eslint . --max-warnings 0",
    "standards:check": "bun run lint:check && bun run typecheck && bun run format:check && bun run audit",
    "typecheck": "tsc --pretty --noEmit -p tsconfig.json",
    "wordcount": "node src/wordcount.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "brace-expansion": "^5.0.7"
  }
}
